# Application Configuration
APP_NAME="Autonomous Excel Intelligence Platform"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="127.0.0.1"

# Database Configuration (SQLite default for dev, PostgreSQL for production)
DATABASE_URL="sqlite+aiosqlite:///./storage/app.db"

# Storage Paths
STORAGE_PATH="./storage"
BACKUP_PATH="./storage/backups"
PROCESSED_PATH="./storage/processed"
LOGS_PATH="./storage/logs"

# AI Engine / LLM Configuration
LLM_PROVIDER="openai" # or "gemini", "anthropic", "azure"
LLM_API_KEY=""
LLM_MODEL="gpt-4o"
LLM_TEMPERATURE=0.0

# Matching Engine Calibration Thresholds
CONFIDENCE_AUTO_THRESHOLD=0.92
CONFIDENCE_REVIEW_THRESHOLD=0.70

# Security & Privacy Settings
DATA_MINIMIZATION_ENABLED=True
AUDIT_LOG_TAMPER_PROTECTION=True
MAX_UPLOAD_SIZE_MB=50

